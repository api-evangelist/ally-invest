{
  "opencollection": "1.0.0",
  "info": {
    "name": "Ally Invest Accounts Member API",
    "version": "v1"
  },
  "items": [
    {
      "info": {
        "name": "Member",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get member profile",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.ally.com/v1/member/profile.json",
            "auth": {
              "type": "apikey",
              "key": "Authorization",
              "value": "{{Authorization}}",
              "placement": "header"
            }
          },
          "docs": "Returns the authenticated member's profile information including account identifiers and user details."
        }
      ]
    }
  ],
  "bundled": true
}