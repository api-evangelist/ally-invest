  "info": {
    "_postman_id": "9e721aad-6b42-4ad5-ae1b-c3432bf8a303",
    "name": "Ally Invest Accounts Utilities API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Ally Invest REST API (originally developed from the TradeKing acquisition) provides programmatic access to self-directed brokerage account management, order placement, real-time and delayed market data, watchlist management, and member profile information. Authentication uses OAuth 1.0 with consumer and token credentials. Responses are available in JSON and XML formats.\n\nContact Support:\n Email: InvestAPI@ally.com",
      "type": "text/plain"
    }
  }
